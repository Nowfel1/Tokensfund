# ---- THORChain ----
THORNODE_URL=https://gateway.liquify.com/chain/thorchain_api
# 1% affiliate fee paid to your THORName (100 basis points).
# BOTH must be set in Vercel — the code checks `if (AFFILIATE && AFFILIATE_BPS)`,
# so one without the other silently applies no fee at all.
THOR_AFFILIATE=TKF
THOR_AFFILIATE_BPS=100

# ---- NEAR Intents (1Click) ----
NEAR_1CLICK_URL=https://1click.chaindefuser.com
# Register at https://partners.near-intents.org for a JWT (fee attribution +
# skips the 0.2% no-key fee). NEVER put the real JWT in this file — it is
# committed to a public repo. Real value goes in Vercel only.
NEAR_1CLICK_JWT=your_jwt_here
# IMPORTANT: appFees on 1Click is split 50/50 with the protocol, so this value
# is the TOTAL the user pays and you net HALF of it:
#   NEAR_APP_FEE_BPS=100  -> user pays 1% total, you net 0.5%  <-- matches the site-wide 1%
#   NEAR_APP_FEE_BPS=200  -> user pays 2% total, you net 1%    (breaks the flat 1% promise)
NEAR_APP_FEE_BPS=100
NEAR_FEE_RECIPIENT=your_near_fee_address

# ---- Chainflip ----
CHAINFLIP_NETWORK=mainnet
# Requires a running broker to collect commission. 100 = 1%.
CHAINFLIP_BROKER_URL=https://broker.tokensfund.xyz
CHAINFLIP_COMMISSION_BPS=100

# ---- Changee ----
# Partner fee is configured on Changee's side, not here. Set to 1% in their
# dashboard to match the rest of the stack.
CHANGEE_API_KEY=your_changee_key

# ---- CCE.Cash ----
# NOTE: CCE has no partner-fee mechanism, and because funds go directly from
# provider to user there is no way to take one. CCE swaps earn nothing, which
# also makes CCE quotes ~1% cheaper than the other routes.
CCE_API_KEY=your_cce_key
CCE_API_SECRET=your_cce_secret
